<Project Sdk="Microsoft.NET.Sdk">

  <!-- Genera el índice del blog y el HTML de cada entrada a partir de Contenido/Blog/*.md.
       Lo ejecuta automáticamente el build de PortafolioBlog; no hace falta llamarlo a mano. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>

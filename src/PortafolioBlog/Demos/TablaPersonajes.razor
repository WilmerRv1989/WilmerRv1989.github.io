@* Demo de "Tablas de datos accesibles": tabla generada desde datos, con aria-label por fila en los botones. *@
<div class="demo border border-2 p-4 rounded">
<table class="table">
    <caption class="table caption-top">Personajes de Los Simpsons</caption>
    <thead>
        <tr>
            <th scope="col">Nombre</th>
            <th scope="col">Apellido</th>
            <th scope="col">Edad</th>
            <th scope="col" colspan="2" class="text-center">Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (PersonaClass persona in personas)
        {
            <tr>
                <td>@persona.Nombre</td>
                <td>@persona.Apellido</td>
                <td>@persona.Edad</td>
                <td><button type="button" aria-label="Editar @persona.Nombre">&#9998;</button></td>
                <td><button type="button" aria-label="Eliminar @persona.Nombre">&#128465;</button></td>
            </tr>
        }
    </tbody>
</table>
</div>


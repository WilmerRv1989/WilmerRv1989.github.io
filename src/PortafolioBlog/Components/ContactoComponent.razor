@* Bloque de contacto compartido por la portada y los artículos.
   En la portada es una sección; en los artículos es contenido complementario (aside). *@

@if (Complementario)
{
    <aside class="@Clases" aria-labelledby="contacto-titulo">@Contenido</aside>
}
else
{
    <section class="@Clases" aria-labelledby="contacto-titulo">@Contenido</section>
}

@code {
    [Parameter] public string Titulo { get; set; } = "Contacto";
    [Parameter] public bool Complementario { get; set; }
    [Parameter] public bool MostrarDetalles { get; set; }

    private const string Clases = "mt-5 py-5 border-top border-bottom text-center rounded shadow-sm bg-dark text-light";

    private record Enlace(string Nombre, string Url);

    private static readonly Enlace[] Enlaces =
    {
        new("GitHub", "https://github.com/WilmerRv1989"),
        new("LinkedIn", "https://www.linkedin.com/in/wilmer-rodriguez-a98b5956/"),
        new("Google Académico", "https://scholar.google.es/citations?user=cVZSyxgAAAAJ&hl=es"),
        new("Club de Escritura", "https://clubdeescritura.com/perfil/171865/wilmer-rodriguez-vega"),
        new("Mastodon", "https://mastodon.cr/@Wilmer"),
        new("Threads", "https://www.threads.com/@rvwilmer"),
        new("Instagram", "https://www.instagram.com/rvwilmer"),
        new("Facebook", "https://www.facebook.com/wilmer.rv"),
        new("Linktree", "https://linktr.ee/Wilmer.Rv.1989"),
    };

    private RenderFragment Contenido => @<text>
        <h2 id="contacto-titulo" class="h4 mb-4 fw-bold">@Titulo</h2>
        @if (MostrarDetalles)
        {
            <p class="mb-4">Ubicación: Costa Rica. Canal preferente: correo electrónico.</p>
        }
        <ul class="list-unstyled d-flex flex-wrap justify-content-center gap-3 px-3 mb-0">
            <li><a class="btn btn-primary" href="mailto:wilmer8981@hotmail.com">wilmer8981@hotmail.com</a></li>
            @foreach (var enlace in Enlaces)
            {
                <li>
                    <a class="btn btn-outline-primary" href="@enlace.Url" target="_blank" rel="noopener">
                        @enlace.Nombre<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
                    </a>
                </li>
            }
            <li>
                <a class="btn btn-outline-primary" href="documents/wilmer_cv.pdf" target="_blank" rel="noopener">
                    CV (PDF)<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
                </a>
            </li>
        </ul>
        @if (MostrarDetalles)
        {
            <p class="mt-4 text-muted">Nota: Mayor actividad en plataformas descentralizadas y de microblogging (Threads y Mastodon).</p>
        }
    </text>;
}

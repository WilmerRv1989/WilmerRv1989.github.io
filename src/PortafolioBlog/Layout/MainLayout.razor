@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<HeadContent>
    <link rel="canonical" href="@UrlCanonica" />
</HeadContent>

<a href="#contenido-principal" class="skip-link" @onclick="SaltarAlContenido" @onclick:preventDefault>Saltar al contenido principal</a>

<div class="page">
    <header>
        <NavMenu />
    </header>

    <main id="contenido-principal">
        <article class="content px-4">
            @Body
        </article>
    </main>

    </div>
<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>&copy; 2026. Desarrollado con amor por Wilmer Rodríguez Vega.</p>
        <p>
            Textos bajo licencia <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.es" target="_blank" rel="license noopener">CC BY-NC-SA 4.0<span class="visually-hidden"> (se abre en una pestaña nueva)</span></a>;
            código bajo licencia <a href="https://github.com/WilmerRv1989/WilmerRv1989.github.io/blob/main/LICENSE" target="_blank" rel="license noopener">MIT<span class="visually-hidden"> (se abre en una pestaña nueva)</span></a>.
        </p>
        <p><q>Nosce te ipsum</q></p>
    </div>
</footer>

@code {
    private const string DominioCanonico = "https://wilmer-rv.com/";

    // URL canónica de la página actual en el dominio propio, sin consulta ni fragmento,
    // para que los buscadores no indexen la copia de wilmerrv1989.github.io ni variantes.
    private string UrlCanonica
    {
        get
        {
            var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);
            var corte = ruta.IndexOfAny(new[] { '?', '#' });
            return DominioCanonico + (corte >= 0 ? ruta[..corte] : ruta);
        }
    }

    // En una SPA el enrutador intercepta los anclajes "#id": se mueve el foco por script
    // para que lector de pantalla y teclado continúen desde el contenido principal.
    private async Task SaltarAlContenido()
    {
        await JSRuntime.InvokeVoidAsync("accessibilityFunctions.focusElement", "contenido-principal");
    }
}

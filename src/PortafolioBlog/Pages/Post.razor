@page "/blog/{ArticleName}"
@using PortafolioBlog.Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>@(postMetadata?.Titulo ?? "Cargando artículo...") - Wilmer</PageTitle>

<div class="container mt-5">
    

    @if (articleHtml == null && componente == null)
    {
        <div class="d-flex align-items-center" role="status">
            <strong>Cargando contenido...</strong>
            <div class="spinner-border ms-auto" aria-hidden="true"></div>
        </div>
    }
    else
    {
        @if (postMetadata is { Borrador: true } or { Programado: true })
        {
            <p class="alert alert-warning mt-4 mb-0">
                Vista previa local: esta entrada es @(postMetadata.Borrador ? "un borrador" : "programada para más adelante") y no aparece en el sitio publicado.
            </p>
        }

        <article class="blog-content mt-4">
            @if (componente != null)
            {
                <DynamicComponent Type="@componente" />
            }
            else if (articleHtml != null)
            {
                @foreach (var parte in DividirEnPartes(articleHtml))
                {
                    if (parte.Demo is not null)
                    {
                        <DynamicComponent Type="@parte.Demo" />
                    }
                    else if (parte.DemoInexistente is not null)
                    {
                        <p class="alert alert-danger">No se encontró la demo «@parte.DemoInexistente».</p>
                    }
                    else
                    {
                        @((MarkupString)parte.Html!)
                    }
                }
            }
        </article>

        <nav class="d-flex justify-content-between align-items-center my-5" aria-label="Navegación entre artículos">
            <div style="flex: 1;">
                @if (prevPost != null)
                {
                    <a href="blog/@prevPost.Id" class="btn btn-outline-primary w-100 text-start shadow-sm">
                        <span class="d-block small">Artículo anterior:</span>
                        <span class="d-block">@prevPost.Titulo</span>
                    </a>
                }
            </div>

            <div class="text-center" style="flex: 0.5;">
                <a href="blog" class="btn btn-link text-decoration-none" aria-label="Volver al índice del blog">
                    <span class="bi bi-grid-3x3-gap" aria-hidden="true" style="font-size: 1.5rem;"></span>
                    <small class="d-block">Índice</small>
                </a>
            </div>

            <div class="text-end" style="flex: 1;">
                @if (nextPost != null)
                {
                    <a href="blog/@nextPost.Id" class="btn btn-outline-primary w-100 text-end shadow-sm">
                        <span class="d-block small">Artículo siguiente:</span>
                        <span class="d-block">@nextPost.Titulo</span>
                    </a>
                }
            </div>
        </nav>
        
        @if (!string.IsNullOrEmpty(ArticleName))
        {
            <ComentariosComponent @key="ArticleName" />
        }
    }
</div>


<ContactoComponent Titulo="Contacto y Redes sociales" Complementario="true" />

@code {
    [Parameter] public string? ArticleName { get; set; }
    private bool foco = false;
    private string? articleHtml;
    private PostMetadata? postMetadata;
    private PostMetadata? prevPost;
    private PostMetadata? nextPost;
    private Type? componente;

    // Un tramo del artículo: HTML generado desde el Markdown, o una demo Razor (Demos/<Nombre>.razor)
    // que el generador dejó marcada como <div data-demo-componente="Nombre"></div>.
    private sealed record ParteArticulo(string? Html, Type? Demo, string? DemoInexistente);

    private static readonly System.Text.RegularExpressions.Regex MarcadorDemo =
        new("<div data-demo-componente=\"([A-Za-z_][A-Za-z0-9_]*)\"></div>");

    private string? htmlDividido;
    private List<ParteArticulo> partes = new();

    private List<ParteArticulo> DividirEnPartes(string html)
    {
        if (ReferenceEquals(html, htmlDividido)) return partes;

        partes = new List<ParteArticulo>();
        var inicio = 0;
        foreach (System.Text.RegularExpressions.Match marcador in MarcadorDemo.Matches(html))
        {
            partes.Add(new ParteArticulo(html[inicio..marcador.Index], null, null));
            var nombre = marcador.Groups[1].Value;
            var tipo = Type.GetType($"PortafolioBlog.Demos.{nombre}");
            partes.Add(new ParteArticulo(null, tipo, tipo is null ? nombre : null));
            inicio = marcador.Index + marcador.Length;
        }
        partes.Add(new ParteArticulo(html[inicio..], null, null));

        htmlDividido = html;
        return partes;
    }

    protected override async Task OnParametersSetAsync()
    {
        foco = true;
        componente = null;
        articleHtml = null;
        postMetadata = null;
        prevPost = null;
        nextPost = null;

        if (!string.IsNullOrEmpty(ArticleName))
        {
            try
            {
                // El índice generado ya contiene solo lo publicable (en Debug, también borradores y programadas).
                var articulos = await Http.GetFromJsonAsync<List<PostMetadata>>("generado/posts.json");

                if (articulos != null)
                {
                    var listaPublicada = articulos
                        .OrderByDescending(p => p.Fecha)
                        .ToList();

                    var currentIndex = listaPublicada.FindIndex(p => p.Id == ArticleName);

                    if (currentIndex != -1)
                    {
                        postMetadata = listaPublicada[currentIndex];

                        nextPost = currentIndex > 0 ? listaPublicada[currentIndex - 1] : null;
                        prevPost = currentIndex < listaPublicada.Count - 1 ? listaPublicada[currentIndex + 1] : null;

                        if (postMetadata.Componente is not null)
                        {
                            // El generador ya verificó que Components/<Componente>.razor existe.
                            componente = Type.GetType($"PortafolioBlog.Components.{postMetadata.Componente}");
                        }
                        else
                        {
                            articleHtml = await Http.GetStringAsync($"generado/articulos/{ArticleName}.html");
                        }
                    }
                    else
                    {
                        //manejar navegación incorrecta
                        articleHtml = "<div class='alert alert-warning text-center mt-5'>" +
                                      "<h3>Contenido no disponible</h3>" +
                                      "</div>";
                    }
                }
            }
            catch (Exception)
            {
                articleHtml = "<p class='alert alert-danger'>Error: No se pudo encontrar el artículo solicitado.</p>";
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // El foco y los scripts se disparan si hay algo cargado (HTML de MD o Componente Razor)
        if (articleHtml != null || componente != null)
        {
            // Ejecutamos el script de copiado para cualquier etiqueta <pre> presente en el DOM
            await JSRuntime.InvokeVoidAsync("clipboardFunctions.addCopyButtons");

            if (foco)
            {
                // Devolvemos el foco al título para una navegación fluida con NVDA
                await JSRuntime.InvokeVoidAsync("accessibilityFunctions.focusElement", "titulo-principal");
                foco = false;
            }
        }
    }
}